{
  "lucidtrading.com": {
    "name": "Lucid Trading",
    "disabled": true,
    "disabledReason": "Handled by lucid-net-intercept.js (auto-applies coupon via WooCommerce AJAX)",
    "checkoutDetection": {
      "type": "url",
      "pattern": "/checkout"
    },
    "autoFillSequence": []
  },
  "tradeify.co": {
    "name": "Tradeify",
    "skipValidation": true,
    "checkoutDetection": {
      "type": "url",
      "pattern": "/checkout"
    },
    "autoFillSequence": [
      {
        "action": "click",
        "selector": ".promo_btn, button[class*='promo']",
        "optional": true
      },
      {
        "action": "wait",
        "duration": 500
      },
      {
        "action": "waitForVisible",
        "selector": "input[placeholder*='promo' i]",
        "maxWait": 3000,
        "optional": true
      },
      {
        "action": "fill",
        "selector": "input[placeholder*='promo' i]",
        "value": "LAB"
      },
      {
        "action": "wait",
        "duration": 300
      },
      {
        "action": "click",
        "selector": "button",
        "content": "Apply",
        "waitForEnabled": true,
        "maxWait": 3000
      }
    ]
  },
